# Copy to app/.env (next to app.py). Do not commit real .env files.
# Values below are placeholders only.

SECRET_KEY=replace-with-long-random-string

# Leave blank to use local app data (recommended on Windows / OneDrive):
#   %LOCALAPPDATA%\TheVapeWorkshopCalculator\tvw_calculator.db
DATABASE_PATH=

# Optional override for the local data directory (parent of tvw_calculator.db)
# TVW_LOCAL_DATA_DIR=

# Disable Werkzeug reloader by default (prevents duplicate SQLite connections)
FLASK_USE_RELOADER=0

# 1 = Lab modules (inventory, Production Jobs, scrapers UI, etc.)
# 0 = Workshop / TVW community routes only
TVW_ENABLE_LAB_MODULES=1

FLASK_ENV=production
PYTHONUTF8=1

# Optional bootstrap passwords for a fresh database only.
# Set at least one before first start if you need an initial login.
# Never commit real values.
# TVW_ADMIN_PASSWORD=
# TVW_OLD_GOAT_PASSWORD=

# Optional: monthly scraper catch-up on startup (Lab)
# RUN_STARTUP_MONTHLY_CATCHUP=false
